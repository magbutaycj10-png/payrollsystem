@echo off
:: ---------------------------------------------------------------
::  secrets.bat.example  ->  copy this file to  secrets.bat
::
::  secrets.bat is listed in .gitignore, so it never reaches GitHub.
::  launch.bat and launch-lan.bat call it automatically.
::
::  Fill these in from the Aiven console:
::    your service -> Overview -> Connection information
::  Put the CA certificate (Download CA cert) beside this file as ca.pem.
::
::  On Render the same names go under the service's Environment
::  settings instead (see SETUP_README.txt).
:: ---------------------------------------------------------------

set DB_HOST=YOUR-SERVICE.aivencloud.com
set DB_PORT=YOUR-PORT
set DB_NAME=defaultdb
set DB_USER=YOUR-USER
set DB_PASS=PUT-YOUR-AIVEN-PASSWORD-HERE
